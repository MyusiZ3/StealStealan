function AnimalConfig.GetByBiome(biomeId: string): { Types.AnimalSpeciesDefinition }
	local list = {}
	for _, spec in AnimalConfig.SPECIES do
		if spec.biomeId == biomeId then
			table.insert(list, spec)
		end
	end
	return list
end

return AnimalConfig
